# Base URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# X OAuth (set real values only when using real X)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/auth/x/callback

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xcleaner?schema=public
REDIS_URL=redis://localhost:6379

# 32-byte base64 key for AES-256-GCM encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Enable real X client only when explicitly set
X_USE_REAL=false

